# =============================================================================
# SmartDataQuery · 环境变量模板
#
# 使用方法：
#   1. 复制本文件为 .env        cp .env.example .env
#   2. 按实际情况修改 .env 中的值
#   .env 已被 .gitignore 忽略，不会被提交到仓库。
# =============================================================================

# ---------------------------- 元数据库（meta） ----------------------------
META_DB_HOST=127.0.0.1
META_DB_PORT=3306
META_DB_USER=root
META_DB_PASSWORD=

# ---------------------------- 数据仓库（dw） ------------------------------
DW_DB_HOST=127.0.0.1
DW_DB_PORT=3306
DW_DB_USER=root
DW_DB_PASSWORD=

# ------------------------------- Qdrant -----------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ------------------------------ Embedding ---------------------------------
EMBEDDING_HOST=127.0.0.1
EMBEDDING_PORT=8081
EMBEDDING_BASE_URL=http://127.0.0.1:8081/v1
EMBEDDING_API_KEY=EMPTY

# --------------------------- Elasticsearch --------------------------------
ES_HOST=127.0.0.1
ES_PORT=9200

# -------------------------------- LLM -------------------------------------
LLM_MODEL_NAME=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
